{
  "name": "firepit-web",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "bun run generate-version && next build",
    "build:webpack": "bun run generate-version && next build --webpack",
    "build:analyze": "ANALYZE=true next build --webpack",
    "generate-version": "bun scripts/generate-version.ts",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,mjs,cjs}\" --fix",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint",
    "setup": "bun scripts/setup-appwrite.ts",
    "validate-env": "bun scripts/validate-env.ts",
    "validate-env:ci": "bun scripts/validate-ci-env.ts",
    "cleanup-orphan-memberships": "bun run scripts/cleanup-orphan-memberships.ts",
    "backfill-thread-read-ids": "bun run scripts/backfill-thread-read-ids.ts",
    "knip": "knip",
    "update:force": "bun i next@latest appwrite@latest node-appwrite@latest",
    "update:pin": "bun i next@latest appwrite@latest node-appwrite@latest --save-exact",
    "update:check": "bun outdated next appwrite node-appwrite"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "appwrite": "^26.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "emoji-picker-react": "^4.19.1",
    "expo-server-sdk": "^6.1.0",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.554.0",
    "nanoid": "^5.1.16",
    "newrelic": "^13.20.0",
    "next": "^16.3.1-canary.20",
    "next-themes": "^0.4.6",
    "node-appwrite": "^27.1.0",
    "node-emoji": "^2.2.0",
    "posthog-js": "^1.417.1",
    "posthog-node": "^5.49.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.11",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "16.3.1",
    "@posthog/nextjs-config": "^1.9.69",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^27.4.0",
    "knip": "^6.32.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
