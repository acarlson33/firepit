{
    "cli": {
        "version": ">= 19.0.5",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "env": {
                    "TMPDIR": "/home/august/eas-build-tmp/"
                }
            },
            "ios": {
                "env": {
                    "TMPDIR": "/home/august/eas-build-tmp/"
                }
            },
            "channel": "development",
            "environment": "development"
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "environment": "preview"
        },
        "production": {
            "autoIncrement": true,
            "channel": "production",
            "environment": "production",
            "developmentClient": false,
            "android": {
                "buildType": "apk"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
