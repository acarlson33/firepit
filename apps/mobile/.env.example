# Environment variables for firepit mobile
# Copy this file to .env.local and fill in your values.
# .env*.local is gitignored — secrets stay local.

# Path to Google services JSON for Android (production build)
GOOGLE_SERVICES=./path/to/google-services.json

# Path to Google services JSON for Android (development build)
GOOGLE_SERVICES_DEV=./path/to/google-services-dev.json

# Path to Google services JSON for Android (preview build)
GOOGLE_SERVICES_PREVIEW=./path/to/google-services-preview.json

# Use React Native's built-in fetch instead of Expo's "winter" fetch.
# Required for FormData file uploads (RN's {uri,name,type} format).
EXPO_PUBLIC_USE_RN_FETCH=1

# App environment: "development", "preview", or "production"
# Controls app name suffix, bundle identifier, and build behavior.
APP_ENV=development

# Sentry (for debug symbol uploads during EAS Build)
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Android keystore credentials (for local production builds — EAS Build uses its own keystore)
# MYAPP_UPLOAD_STORE_FILE=firepit-upload.keystore
# MYAPP_UPLOAD_STORE_PASSWORD=your-store-password
# MYAPP_UPLOAD_KEY_ALIAS=upload
# MYAPP_UPLOAD_KEY_PASSWORD=your-key-password
